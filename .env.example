# Sao chép thành ".env" khi chạy local (tệp .env KHÔNG commit).
# Trên Railway KHÔNG cần tệp này — đặt biến trong tab Variables của service web:
#   DATABASE_URL   = ${{Postgres.DATABASE_URL}}    <- reference sang service Postgres
#   SESSION_SECRET = (chuỗi ngẫu nhiên dài, tự đặt)
DATABASE_URL=postgresql://postgres:matkhau@localhost:5432/tinhoc
SESSION_SECRET=doi-thanh-chuoi-ngau-nhien-dai
# DATABASE_SSL=1   # chỉ bật nếu nối DB ngoài qua internet mà báo lỗi SSL
