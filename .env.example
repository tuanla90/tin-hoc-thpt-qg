# Sao chép thành ".env" khi chạy local (tệp .env KHÔNG commit).
# Trên Railway KHÔNG cần tệp này — đặt biến trong tab Variables của service web:
#   DATABASE_URL   = ${{Postgres.DATABASE_URL}}    <- reference sang service Postgres
#   SESSION_SECRET = (chuỗi ngẫu nhiên dài, tự đặt)
DATABASE_URL=postgresql://postgres:matkhau@localhost:5432/tinhoc
SESSION_SECRET=doi-thanh-chuoi-ngau-nhien-dai
# DATABASE_SSL=1   # chỉ bật nếu nối DB ngoài qua internet mà báo lỗi SSL

# --- GIA SƯ AI ---------------------------------------------------------------
# Thiếu AI_PROVIDER hoặc AI_API_KEY -> tính năng tự tắt: nút "Hỏi gia sư" không
# hiện, phần còn lại của app chạy bình thường.
# KHOÁ API CHỈ ĐẶT Ở ĐÂY / Ở RAILWAY VARIABLES — không bao giờ nhúng vào public/.
AI_PROVIDER=mock                 # claude | gemini | mock (mock = chạy thử, không tốn tiền)
# AI_API_KEY=...                 # Claude: khoá Anthropic — Gemini: khoá Google AI Studio
# AI_MODEL=claude-haiku-4-5-20251001        # hoặc gemini-2.5-flash
# AI_MODEL_DEEP=claude-sonnet-5             # model mạnh hơn cho "giải thích kỹ hơn"
AI_FREE_PER_DAY=5                # lượt hỏi/ngày cho tài khoản miễn phí
AI_PAID_PER_DAY=25               # lượt hỏi/ngày cho tài khoản trả phí
AI_IP_PER_HOUR=60                # trần lượt/giờ theo IP (chặn lập hàng loạt tài khoản)
# Nghẽn (429) hay sự cố tạm của nhà cung cấp -> tự thử lại theo các nhịp chờ này
# (mili-giây, phân cách bằng dấu phẩy). Để rỗng là tắt hẳn thử lại.
# AI_RETRY_MS=1200,3000

# --- THANH TOÁN TỰ ĐỘNG (SePay: tiền vào là tự mở Premium, không cần gửi mã) --
# Thiếu khoá/số tài khoản -> tính năng tự tắt, app quay về bán bằng mã kích hoạt.
PAY_PROVIDER=mock                # sepay | mock (mock = chạy thử, không cần khoá)
# PAY_API_KEY=...                # SePay: Cấu hình > Webhooks > API Key (tự đặt, dán y hệt hai bên)
# PAY_BANK=vietcombank           # mã/tên ngắn ngân hàng nhận tiền (xem vietqr.app/banks.json)
# PAY_STK=0011002233445          # số tài khoản nhận tiền
# PAY_CHU_TK=NGUYEN VAN A        # tên chủ tài khoản, không dấu
# PAY_GIA_NAM=249000             # giá gói 1 năm học
# PAY_GIA_NUOCRUT=149000         # giá gói nước rút 3 tháng
# URL webhook khai bên SePay: https://<domain>/api/pay/webhook
#   - Kiểu xác thực: API Key, giá trị = PAY_API_KEY ở trên
#   - SePay gửi lại tối đa 7 lần nếu chưa nhận được xác nhận, nên không sợ mất đơn.

# --- BÁN HÀNG (gói Premium bằng mã kích hoạt) --------------------------------
# Email nào nằm trong danh sách này, đăng nhập xong tự thành admin (vào được
# /admin.html để tạo lô mã, xem doanh số). Phân cách nhiều email bằng dấu phẩy.
# ADMIN_EMAILS=ban@gmail.com
