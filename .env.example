# Sao chép thành ".env" khi chạy local (tệp .env KHÔNG commit).
# Trên Railway KHÔNG cần tệp này — đặt biến trong tab Variables của service web:
#   DATABASE_URL   = ${{Postgres.DATABASE_URL}}    <- reference sang service Postgres
#   SESSION_SECRET = (chuỗi ngẫu nhiên dài, tự đặt)
DATABASE_URL=postgresql://postgres:matkhau@localhost:5432/tinhoc
SESSION_SECRET=doi-thanh-chuoi-ngau-nhien-dai
# DATABASE_SSL=1   # chỉ bật nếu nối DB ngoài qua internet mà báo lỗi SSL

# --- GIA SƯ AI ---------------------------------------------------------------
# Thiếu AI_PROVIDER hoặc AI_API_KEY -> tính năng tự tắt: nút "Hỏi gia sư" không
# hiện, phần còn lại của app chạy bình thường.
# KHOÁ API CHỈ ĐẶT Ở ĐÂY / Ở RAILWAY VARIABLES — không bao giờ nhúng vào public/.
AI_PROVIDER=mock                 # claude | gemini | mock (mock = chạy thử, không tốn tiền)
# AI_API_KEY=...                 # Claude: khoá Anthropic — Gemini: khoá Google AI Studio
# AI_MODEL=claude-haiku-4-5-20251001        # hoặc gemini-2.5-flash
# AI_MODEL_DEEP=claude-sonnet-5             # model mạnh hơn cho "giải thích kỹ hơn"
AI_FREE_PER_DAY=5                # lượt hỏi/ngày cho tài khoản miễn phí
AI_PAID_PER_DAY=50               # lượt hỏi/ngày cho tài khoản trả phí
AI_IP_PER_HOUR=60                # trần lượt/giờ theo IP (chặn lập hàng loạt tài khoản)
